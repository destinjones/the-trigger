{
  "name": "the-trigger",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source AI dividend readiness tracker. Git is the database.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && astro check --root web",
    "lint": "eslint .",
    "snapshot": "tsx scripts/snapshot.ts",
    "scorecard": "tsx scripts/scorecard.ts",
    "health": "tsx scripts/health.ts",
    "dev": "astro dev --root web",
    "build": "astro build --root web",
    "check-site": "tsx scripts/check-site.ts",
    "preview": "astro preview --root web"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^10.0.1",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^22.20.5",
    "eslint": "^10.13.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@astrojs/preact": "^6.1.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "astro": "^7.4.0",
    "preact": "^10.29.8",
    "yaml": "^2.9.1"
  }
}
