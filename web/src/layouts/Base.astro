---
import '../styles/global.css';
import { REPO_URL, latest, weightsPath } from '../lib/data.ts';

interface Props {
  title: string;
  description: string;
  page: 'index' | 'method' | 'calculator' | 'log';
}
const { title, description, page } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const site = (Astro.site?.toString() ?? '').replace(/\/$/, '');
const pageUrl = `${site}${Astro.url.pathname}`;
// Rendered at build time from the latest snapshot by src/pages/og.png.ts.
const ogImage = `${site}${base}/og.png`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={pageUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="The Trigger" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={description} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="alternate" type="application/rss+xml" title="The Trigger: what moved" href={`${site}${base}/rss.xml`} />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header class="topbar">
      <div class="wrap">
        <a class="brand" href={`${base}/`}>THE TRIGGER<span>_</span></a>
        <span class="muted mono snap">snapshot {latest.date} r{latest.revision}</span>
        <nav>
          <a href={`${base}/`} aria-current={page === 'index' ? 'page' : undefined}>Tracker</a>
          <a href={`${base}/calculator`} aria-current={page === 'calculator' ? 'page' : undefined}>What you'd get</a>
          <a href={`${base}/log`} aria-current={page === 'log' ? 'page' : undefined}>What moved</a>
          <a href={`${base}/method`} aria-current={page === 'method' ? 'page' : undefined}>Method</a>
          <a href={REPO_URL}>Source</a>
        </nav>
      </div>
    </header>
    <main class="wrap">
      <slot />
    </main>
    <footer class="site">
      <div class="wrap">
        <a href={`${base}/method`}>Method and known weaknesses (required reading)</a>
        <a href={`${REPO_URL}/blob/main/${weightsPath}`}>Fork the weights</a>
        <a href={`${REPO_URL}/blob/main/SCOREBOARD.md`}>Our prediction record</a>
        <a href={`${REPO_URL}/blob/main/DATA_LICENSE.md`}>Data sources and terms</a>
        <a href={`${REPO_URL}/commits/main/data`}>Every snapshot (git history)</a>
        <span>Not financial or policy advice. Code MIT.</span>
      </div>
    </footer>
  </body>
</html>
