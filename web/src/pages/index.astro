---
import Base from '../layouts/Base.astro';
import Dial from '../components/Dial.astro';
import GapChart from '../components/GapChart.astro';
import SubIndex from '../components/SubIndex.tsx';
import MetricCard from '../components/MetricCard.tsx';
import BillRow from '../components/BillRow.tsx';
import WhoMoving from '../components/WhoMoving.tsx';
import SourceCite from '../components/SourceCite.tsx';
import { billsObserved, challengerMonthly, fileUrl, latest, ledger, metric, previous, series, snapshotUrl, weights } from '../lib/data.ts';
import { gapSeries as buildGapSeries } from '../lib/gap.ts';
import { wireItems } from '../lib/wire.ts';
import { leadFund, leadPlan, salaryFund, shortfall } from '../lib/payoutFacts.ts';
import { fmtNumber } from '../lib/format.ts';
import { cuts, cutsLabel, description, gapCopy, moved, movedLabel, title } from '../lib/headline.ts';
import { normalize } from '../../../index/normalize.ts';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const method = (hash = '') => `${base}/method${hash}`;
const snapUrl = snapshotUrl(latest);
const siteRoot = `${(Astro.site?.toString() ?? '').replace(/\/$/, '')}${base}`;

const subKeys = Object.keys(weights.subIndices);
const metricsFor = (key: string | null) =>
  latest.metrics.filter((m) => (key === null ? weights.metrics[m.metricId] === null : weights.metrics[m.metricId] === key));

const gap = (s: typeof latest) => {
  const d = s.subIndices.labor_dislocation;
  const p = s.subIndices.political_momentum;
  return d === null || p === null || d === undefined || p === undefined ? null : d - p;
};
const gapNow = gap(latest);
const gapText = gapCopy(gapNow, latest.subIndices.labor_dislocation, latest.subIndices.political_momentum);

// Sub-indices grouped by the `group` each one declares in the weights file.
const GROUP_COPY: Record<string, { title: string; sub: string }> = {
  pressure: { title: 'Pressure', sub: 'what forces a dividend' },
  response: { title: 'Response', sub: 'who is moving toward one' },
  backdrop: { title: 'Backdrop', sub: 'what makes one possible' },
};
const groupKeys = [...new Set(subKeys.map((k) => weights.subIndices[k]?.group ?? 'all'))];
const groups = groupKeys.map((g) => ({
  ...(GROUP_COPY[g] ?? { title: 'Sub-indices', sub: `weights ${latest.weightsVersion}` }),
  keys: subKeys.filter((k) => (weights.subIndices[k]?.group ?? 'all') === g),
}));
const gapPts = buildGapSeries(challengerMonthly, billsObserved);
const gapFrom = challengerMonthly[0]?.month;
const wire = wireItems(latest, previous);
const cutsYtd = metric(latest, 'labor.ai_layoffs_ytd');
const cutsShown = cutsYtd ?? cuts;
const live = latest.bills.filter((b) => b.status !== 'expired').length;

const filings = latest.filings ?? [];
const edgarMetric = metric(latest, 'corporate.capex_headcount_gap_pp');
const openPredictions = ledger.predictions.filter((p) => p.status === 'open');
---
<Base title={title} description={description} page="index">
  <div class="wire" slot="wire" aria-label="Latest changes and upstream records">
    <div class="wire-track">
      {[0, 1].map((copy) => wire.map((w) => (
        <span class="wire-item" aria-hidden={copy === 1 ? 'true' : undefined}>
          <b>{w.date}</b>{w.href ? <a href={w.href} tabindex={copy === 1 ? -1 : undefined}>{w.text}</a> : w.text}
        </span>
      )))}
    </div>
  </div>

  <section class="headline">
    <h1>The layoffs started. <span>The checks haven't.</span></h1>
    <p class="lede">
      The Trigger tracks how close the US is to paying every citizen a dividend funded by AI.
      Every number is cited, every snapshot is in git, and every projection is graded in public.
    </p>
  </section>

  <section class="instrument">
    <div class="panel">
      <Dial
        readiness={latest.readiness}
        projectedDate={latest.projectedDate}
        bandMonths={latest.bandMonths}
        confidence={latest.confidence}
        asOf={latest.date}
        citeHref={snapUrl}
        methodHref={method('#projection')}
      />
    </div>
    <div class="panel">
      <div class="panel-head">
        <h2>The gap{gapFrom ? `, since ${gapFrom}` : ''}</h2>
        <SourceCite href={fileUrl('sources/curated/challenger.yaml')} name="Challenger monthly reports, Congress.gov" />
      </div>
      <GapChart pts={gapPts} />
      <div class="gap-facts">
        <div class="stat">
          <div class="lbl">AI-attributed cuts, {cutsYtd ? cutsYtd.asOf.slice(0, 4) : 'last 12 mo'}</div>
          <div class="stat-value red" data-counter={cutsYtd ? JSON.stringify({ ytd: cutsYtd.value, asOf: cutsYtd.asOf }) : undefined}>
            {cutsShown?.value.toLocaleString('en-US') ?? '—'}
          </div>
          <div class="stat-note">{cutsYtd ? `${cutsYtd.value.toLocaleString('en-US')} reported to ${cutsYtd.asOf}; live figure interpolated from YTD ÷ days elapsed` : cutsLabel}</div>
          {cutsShown && <SourceCite href={cutsShown.sourceUrl} name={cutsShown.sourceName} asOf={cutsShown.asOf} />}
        </div>
        <div class="stat">
          <div class="lbl">{movedLabel}</div>
          <div class={`stat-value ${moved && moved.value === 0 ? 'red' : 'amber'}`}>{moved ? moved.value : '—'}</div>
          <div class="stat-note">of {live} introduced and watched</div>
          {moved && <SourceCite href={moved.sourceUrl} name={moved.sourceName} asOf={moved.asOf} stale={moved.stale} />}
        </div>
        <div class="stat">
          <div class="lbl">Labor minus politics</div>
          <div class={`stat-value ${gapNow !== null && gapNow > 2 ? 'red' : 'amber'}`}>{gapNow === null ? '—' : `${gapNow >= 0 ? '+' : '−'}${Math.abs(gapNow).toFixed(1)}`}</div>
          <div class="stat-note">{gapText.head.toLowerCase()}</div>
          <SourceCite href={snapUrl} name="snapshot sub-indices" />
        </div>
      </div>
      {leadFund && shortfall && (
        <p class="gap-line">
          $1,000/month for everyone needs an <span class="num">{fmtNumber(salaryFund, 'USD')}</span> fund.
          The bill creates <span class="num">{fmtNumber(leadFund, 'USD')}</span>. <span class="num">{shortfall.toFixed(0)}×</span> short.{' '}
          <SourceCite href={leadPlan.sourceUrl} name={leadPlan.name.split(',')[0] ?? leadPlan.name} /> <a class="small" href={`${base}/calculator`}>what you'd get</a>
        </p>
      )}
    </div>
  </section>

  <section class="panel">
    <div class="gap-row">
      <div>
        <div class="gap-head">{gapText.head}</div>
        <p class="small">{gapText.body}</p>
      </div>
    </div>
    <p class="thesis" style="margin-top:14px">
      Checks do not arrive from goodwill. They arrive when consumer spending breaks: AI cuts
      white-collar payroll, displaced workers stop spending, everyone else bleeds, politicians panic.
    </p>
    <p class="small" style="margin:12px 0 0"><a href={`${base}/what-would-move-it`}>What would have to happen to move the score</a> · <a href={`${base}/calculator`}>What a dividend would actually pay you</a></p>
  </section>

  <section class="groups">
    {groups.map((g) => (
      <div class="group">
        <div class="group-title"><b>{g.title}</b><span>{g.sub}</span></div>
        <div class="grid">
          {g.keys.map((k) => (
            <div class="panel">
              <SubIndex
                label={weights.subIndices[k]?.label ?? k}
                value={latest.subIndices[k] ?? null}
                weight={weights.subIndices[k]?.weight ?? 0}
                metricCount={metricsFor(k).length}
                citeHref={snapUrl}
                methodHref={method(`#${k}`)}
              />
            </div>
          ))}
        </div>
      </div>
    ))}
  </section>

  {subKeys.map((k) => metricsFor(k).length > 0 && (
    <section>
      <div class="group-title"><b>{weights.subIndices[k]?.label}</b><span>{metricsFor(k).length} input{metricsFor(k).length === 1 ? "" : "s"}</span></div>
      <div class="grid metrics">
        {metricsFor(k).map((m) => (
          <MetricCard metric={m} prior={metric(previous, m.metricId)} score={normalize(m.metricId, m.value)} history={series((s) => metric(s, m.metricId)?.value)} />
        ))}
      </div>
    </section>
  ))}

  <section>
    <div class="panel">
      <div class="panel-head"><h2>Federal bills</h2><a class="small" href={fileUrl('sources/watchlist.yaml')}>watchlist</a></div>
      <div class="table-wrap">
        <table class="table">
          <thead><tr><th>Latest</th><th>Bill</th><th>Co-sp.</th><th>Status</th><th>Source</th></tr></thead>
          <tbody>{latest.bills.map((b) => <BillRow bill={b} today={latest.date} />)}</tbody>
        </table>
      </div>
    </div>
    <div class="panel" style="margin-top:12px">
      <div class="panel-head"><h2>Who's moving</h2><a class="small" href={fileUrl('sources/curated/actors.yaml')}>roster</a></div>
      <div class="table-wrap"><WhoMoving actors={latest.actors} /></div>
    </div>
  </section>

  <section class="panel">
    <div class="panel-head">
      <h2>Spent on compute, cut from payroll (SEC 10-K)</h2>
      {edgarMetric && <SourceCite href={edgarMetric.sourceUrl} name={edgarMetric.sourceName} asOf={edgarMetric.asOf} stale={edgarMetric.stale} />}
    </div>
    {filings.length === 0 ? (
      <p class="small muted">
        No filings parsed in this snapshot{latest.sourceErrors.edgar ? ` (EDGAR: ${latest.sourceErrors.edgar.slice(0, 160)})` : ''}.
        The daily job reads capex from XBRL and headcount from each company's last two 10-Ks.
      </p>
    ) : (
      <div class="table-wrap">
        <table class="table">
          <thead><tr><th>Company</th><th>FY end</th><th>Capex</th><th>Capex YoY</th><th>Headcount</th><th>Headcount YoY</th><th>Source</th></tr></thead>
          <tbody>
            {filings.map((f) => (
              <tr>
                <td>{f.company} <span class="muted">{f.ticker}</span></td>
                <td class="num">{f.periodEnd}</td>
                <td class="num">{fmtNumber(f.capexUsd, 'USD')}</td>
                <td class="num">{f.capexYoyPct === null ? '—' : `${f.capexYoyPct >= 0 ? '+' : '−'}${Math.abs(f.capexYoyPct).toFixed(1)}%`}</td>
                <td class="num">{f.headcount === null ? '—' : f.headcount.toLocaleString('en-US')}</td>
                <td class={`num ${f.headcountYoyPct !== null && f.headcountYoyPct < 0 ? 'red' : ''}`}>{f.headcountYoyPct === null ? '—' : `${f.headcountYoyPct >= 0 ? '+' : '−'}${Math.abs(f.headcountYoyPct).toFixed(1)}%`}</td>
                <td><SourceCite href={f.sourceUrl} name="10-K" /></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}
  </section>

  {metricsFor(null).length > 0 && (
    <section>
      <div class="group-title"><b>Calibration, unscored</b><span>recorded to check our projection against, never added to the index</span></div>
      <div class="grid metrics">
        {metricsFor(null).map((m) => (
          <MetricCard metric={m} prior={metric(previous, m.metricId)} score={null} history={series((s) => metric(s, m.metricId)?.value)} />
        ))}
      </div>
    </section>
  )}

  <section class="panel">
    <div class="panel-head"><h2>Embed the live number</h2><a class="small" href={`${base}/badge.svg`}>badge.svg</a></div>
    <div class="embed">
      <img src={`${base}/badge.svg`} alt={`AI dividend readiness ${latest.readiness.toFixed(1)}/100`} height="20" />
      <code>{`<a href="${siteRoot}/"><img src="${siteRoot}/badge.svg" alt="AI dividend readiness, The Trigger"></a>`}</code>
    </div>
    <p class="small muted" style="margin:8px 0 0">Rebuilt with every daily snapshot.</p>
  </section>

  <section class="two-col">
    <div class="panel">
      <div class="panel-head"><h2>Open predictions</h2><SourceCite href={fileUrl('predictions/ledger.json')} name="ledger" /></div>
      <table class="table">
        <thead><tr><th>Made</th><th>Claim</th><th>Conf.</th></tr></thead>
        <tbody>
          {openPredictions.map((p) => (
            <tr><td class="num nowrap">{p.madeOn}</td><td>{p.claim}</td><td class="num">{Math.round(p.confidence * 100)}%</td></tr>
          ))}
        </tbody>
      </table>
      <p class="small muted" style="margin-top:8px">Every projection is logged and graded. <a href={fileUrl('SCOREBOARD.md')}>Scoreboard</a>.</p>
    </div>
    <div class="panel">
      <div class="panel-head"><h2>Source status, this snapshot</h2><SourceCite href={snapUrl} name={`${latest.date} r${latest.revision}`} /></div>
      <div class="status">
        {latest.sourcesOk.map((s) => <span class="ok">● {s}</span>)}
        {latest.sourcesFailed.map((s) => <span class="bad" title={latest.sourceErrors[s]}>● {s} failed</span>)}
        {(latest.sourcesSkipped ?? []).map((s) => <span title="API key not configured">○ {s} skipped</span>)}
      </div>
      <p class="small muted" style="margin-top:12px">
        Coverage <span class="num">{latest.sourceCoveragePct}%</span> of sources live,
        <span class="num"> {Math.round(latest.weightCovered * 100)}%</span> of index weight fed.
        Failed sources reuse their last known value, marked stale.
        {latest.sourcesFailed.length > 0 && <> Hover a failed source for the error.</>}
      </p>
    </div>
  </section>
</Base>

<script>
  import { interpolate, startCounters } from '../lib/counter.ts';
  const items = [...document.querySelectorAll<HTMLElement>('[data-counter]')].flatMap((el) => {
    const { ytd, asOf } = JSON.parse(el.dataset.counter ?? '{}') as { ytd?: number; asOf?: string };
    if (typeof ytd !== 'number' || !asOf) return [];
    return [{ el, c: interpolate(ytd, `${asOf}T23:59:59Z`, `${asOf.slice(0, 4)}-01-01T00:00:00Z`) }];
  });
  if (items.length && !matchMedia('(prefers-reduced-motion: reduce)').matches) startCounters(items);
</script>
