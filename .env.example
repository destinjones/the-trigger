# Optional keys. Every source degrades gracefully without them.
CONGRESS_API_KEY=      # https://api.congress.gov/sign-up/  (falls back to DEMO_KEY)
FRED_API_KEY=          # https://fred.stlouisfed.org/docs/api/api_key.html (falls back to public CSV)
BLS_API_KEY=           # optional v2 key; v1 works without one
LEGISCAN_API_KEY=      # https://legiscan.com/legiscan
SEC_USER_AGENT=        # "the-trigger you@example.com" — SEC requires a contact UA
